{
  "$schema": "https://mintlify.com/schema.json",
  "name": "FuzzyFilter",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5",
    "anchors": {
      "from": "#6366F1",
      "to": "#8B5CF6"
    }
  },
  "llmsTxt": {
    "enabled": true
  },
  "topbarLinks": [
    {
      "name": "React Demo",
      "url": "https://fuzzyfilter-react.vercel.app"
    },
    {
      "name": "Vue Demo",
      "url": "https://fuzzyfilter-vue.vercel.app"
    }
  ],
  "topbarCtaButton": {
    "name": "FuzzyFilter",
    "url": "https://fuzzyfilter.vercel.app"
  },
  "tabs": [
    {
      "name": "Getting Started",
      "url": "/"
    },
    {
      "name": "Core API",
      "url": "/core"
    },
    {
      "name": "React",
      "url": "/react"
    },
    {
      "name": "Vue",
      "url": "/vue"
    }
  ],
  "navigation": [
    {
      "group": "Getting Started",
      "pages": ["introduction", "quickstart", "installation"]
    },
    {
      "group": "Guides",
      "pages": ["guides/basic-usage", "guides/schema-definition", "guides/i18n"]
    },
    {
      "group": "Core API",
      "pages": ["core/index"]
    },
    {
      "group": "React",
      "pages": ["react/index"]
    },
    {
      "group": "Vue",
      "pages": ["vue/index"]
    }
  ],
  "footerSocials": {
    "website": "https://fuzzyfilter.vercel.app"
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  }
}
