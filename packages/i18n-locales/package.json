{
  "name": "@fuzzyfilter/i18n-locales",
  "version": "0.1.1",
  "description": "Locale translations for FuzzyFilter (English, Spanish, French, etc.)",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./es": {
      "import": "./src/es.ts",
      "types": "./src/es.ts"
    },
    "./fr": {
      "import": "./src/fr.ts",
      "types": "./src/fr.ts"
    },
    "./en": {
      "import": "./src/en.ts",
      "types": "./src/en.ts"
    }
  },
  "peerDependencies": {
    "fuzzyfilter": "workspace:*"
  },
  "packageManager": "bun@1.3.5"
}
