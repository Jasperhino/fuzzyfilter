# Axiom Benchmark Configuration
# Copy this file to .env and fill in the values to enable benchmark telemetry export

# Axiom API token with Ingest permission for fuzzyfilter-bench dataset
AXIOM_TOKEN=your-axiom-api-token

# Axiom dataset name
AXIOM_DATASET=fuzzyfilter-bench

# Optional: Environment tag (default: local)
# BENCHMARK_ENV=local

# Optional: Git commit SHA for regression tracking
# GIT_COMMIT=abc123
