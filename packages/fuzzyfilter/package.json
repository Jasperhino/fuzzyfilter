{
  "name": "fuzzyfilter",
  "version": "0.1.0",
  "description": "A fuzzy filtering library with intelligent suggestions",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react/index.ts",
      "types": "./src/react/index.ts"
    },
    "./i18n/locales": {
      "import": "./src/i18n/locales/index.ts",
      "types": "./src/i18n/locales/index.ts"
    },
    "./i18n/adapters": {
      "import": "./src/i18n/adapters/index.ts",
      "types": "./src/i18n/adapters/index.ts"
    },
    "./i18n/adapters/i18next": {
      "import": "./src/i18n/adapters/i18next.ts",
      "types": "./src/i18n/adapters/i18next.ts"
    },
    "./i18n/adapters/vue-i18n": {
      "import": "./src/i18n/adapters/vue-i18n.ts",
      "types": "./src/i18n/adapters/vue-i18n.ts"
    },
    "./types/i18n": {
      "import": "./src/types/i18n.ts",
      "types": "./src/types/i18n.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "bench": "bun run src/benchmark.ts",
    "bench:profile": "bun --cpu-prof run src/benchmark.ts",
    "bench:otel": "bun run src/benchmark-otel.ts"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "chrono-node": "^2.7.7",
    "roaring": "^2.6.0"
  },
  "devDependencies": {
    "@fuzzyfilter/axiom-exporter": "workspace:*",
    "@fuzzyfilter/sample-data": "workspace:*",
    "i18next": "^23.15.0",
    "vue-i18n": "^9.14.0",
    "mitata": "^1.0.10"
  },
  "peerDependencies": {
    "typescript": "^5",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "fuzzy",
    "filter",
    "search",
    "suggestions",
    "autocomplete"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.5"
}