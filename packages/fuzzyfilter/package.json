{
  "name": "@jasperhino/fuzzyfilter",
  "version": "0.1.3",
  "description": "A fuzzy filtering library with intelligent suggestions",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./i18n/adapters": {
      "import": "./dist/i18n/adapters/index.js",
      "types": "./dist/i18n/adapters/index.d.ts"
    },
    "./i18n/adapters/i18next": {
      "import": "./dist/i18n/adapters/i18next.js",
      "types": "./dist/i18n/adapters/i18next.d.ts"
    },
    "./i18n/adapters/vue-i18n": {
      "import": "./dist/i18n/adapters/vue-i18n.js",
      "types": "./dist/i18n/adapters/vue-i18n.d.ts"
    },
    "./types/i18n": {
      "import": "./dist/types/i18n.js",
      "types": "./dist/types/i18n.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "bench": "bun run src/benchmark.ts",
    "bench:profile": "bun --cpu-prof run src/benchmark.ts",
    "bench:otel": "bun run src/benchmark-otel.ts"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "chrono-node": "^2.7.7",
    "roaring": "^2.6.0"
  },
  "devDependencies": {
    "@fuzzyfilter/axiom-exporter": "workspace:*",
    "@fuzzyfilter/sample-data": "workspace:*",
    "i18next": "^23.15.0",
    "vue-i18n": "^9.14.0",
    "mitata": "^1.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "fuzzy",
    "filter",
    "search",
    "suggestions",
    "autocomplete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jasperhino/fuzzyfilter",
    "directory": "packages/fuzzyfilter"
  },
  "homepage": "https://github.com/Jasperhino/fuzzyfilter#readme",
  "bugs": {
    "url": "https://github.com/Jasperhino/fuzzyfilter/issues"
  },
  "packageManager": "bun@1.3.5"
}