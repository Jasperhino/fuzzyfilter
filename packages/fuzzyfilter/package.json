{
  "name": "fuzzyfilter",
  "version": "0.1.0",
  "description": "A fuzzy filtering library with intelligent suggestions",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react/index.ts",
      "types": "./src/react/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "bench": "bun run src/benchmark.ts",
    "bench:profile": "bun --cpu-prof run src/benchmark.ts"
  },
  "dependencies": {
    "fuzzysort": "^3.1.0",
    "chrono-node": "^2.7.7",
    "roaring": "^2.6.0"
  },
  "devDependencies": {
    "@fuzzyfilter/sample-data": "workspace:*",
    "mitata": "^1.0.10"
  },
  "peerDependencies": {
    "typescript": "^5",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": ["fuzzy", "filter", "search", "suggestions", "autocomplete"],
  "license": "MIT"
}


