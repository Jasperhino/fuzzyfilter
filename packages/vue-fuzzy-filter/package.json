{
  "name": "vue-fuzzy-filter",
  "version": "0.1.0",
  "description": "Vue 3 composable for FuzzyFilter",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "docs:generate": "bunx mint-tsdocs generate"
  },
  "peerDependencies": {
    "fuzzyfilter": ">=0.1.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "fuzzyfilter": "workspace:*",
    "typescript": "^5.7.3",
    "vue": "^3.5.24"
  },
  "keywords": [
    "vue",
    "vue3",
    "composable",
    "fuzzy",
    "filter",
    "search",
    "autocomplete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jasperhino/fuzzyfilter",
    "directory": "packages/vue-fuzzy-filter"
  },
  "homepage": "https://github.com/Jasperhino/fuzzyfilter#readme",
  "bugs": {
    "url": "https://github.com/Jasperhino/fuzzyfilter/issues"
  },
  "packageManager": "bun@1.3.5"
}
