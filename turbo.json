{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**",
        ".vercel/**",
        ".mintlify/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "e2e": {
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "CI"
      ],
      "outputs": [
        "playwright-report/**",
        "test-results/**"
      ],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "deploy:preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "deploy:link": {
      "cache": false
    },
    "docs:generate": {
      "outputs": [
        "../../docs/core/api/**",
        "../../docs/react/api/**",
        "../../docs/vue/api/**"
      ]
    }
  }
}