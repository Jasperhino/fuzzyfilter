{
  "name": "fuzzyfilter-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=fuzzyfilter",
    "test:e2e": "cd packages/e2e-tests && bun x playwright test",
    "test:e2e:ui": "cd packages/e2e-tests && bun x playwright test --ui",
    "lint": "turbo run lint",
    "deploy": "turbo run deploy --filter='./apps/*'",
    "deploy:preview": "turbo run deploy:preview --filter='./apps/*'",
    "deploy:link": "turbo run deploy:link --filter='./apps/*'",
    "deploy:landing": "turbo run deploy --filter=landing",
    "deploy:react": "turbo run deploy --filter=fuzzyfilter-react",
    "deploy:vue": "turbo run deploy --filter=fuzzyfilter-vue"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.7.2"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=18"
  }
}