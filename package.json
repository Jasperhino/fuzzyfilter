{
  "name": "fuzzyfilter-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "bench": "bun run --filter @jasperhino/fuzzyfilter bench",
    "bench:otel": "bun run --filter @jasperhino/fuzzyfilter bench:otel",
    "deploy": "turbo run deploy --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:preview": "turbo run deploy:preview --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:link": "turbo run deploy:link --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:react": "turbo run deploy --filter=fuzzyfilter-react-demo",
    "deploy:vue": "turbo run deploy --filter=fuzzyfilter-vue-demo",
    "deploy:docs": "turbo run deploy --filter=fuzzyfilter-docs",
    "docs:generate": "turbo run docs:generate",
    "docs:dev": "cd docs && mintlify dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish-packages": "turbo run build --filter=@jasperhino/fuzzyfilter --filter=fuzzyfilter-react --filter=fuzzyfilter-vue && changeset publish"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@types/bun": "latest",
    "eslint": "^9.28.0",
    "mint-tsdocs": "^0.0.4",
    "mintlify": "^4.2.257",
    "tsup": "^8.3.5",
    "turbo": "^2.7.3"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": "24"
  },
  "overrides": {
    "@stoplight/spectral-core": "1.18.3",
    "@stoplight/spectral-formats": "1.6.0",
    "@stoplight/spectral-formatters": "1.3.0",
    "@stoplight/spectral-functions": "1.7.2",
    "@stoplight/spectral-parsers": "1.0.3",
    "@stoplight/spectral-rulesets": "1.18.1",
    "@stoplight/spectral-runtime": "1.1.2"
  },
  "dependencies": {
    "mint": "^4.2.258"
  }
}