{
  "name": "fuzzyfilter-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=fuzzyfilter",
    "test:e2e": "cd packages/e2e-tests && bun x playwright test",
    "test:e2e:ui": "cd packages/e2e-tests && bun x playwright test --ui",
    "lint": "turbo run lint",
    "bench": "bun run --filter fuzzyfilter bench",
    "bench:otel": "bun run --filter fuzzyfilter bench:otel",
    "deploy": "turbo run deploy --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:preview": "turbo run deploy:preview --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:link": "turbo run deploy:link --filter='./apps/*' --filter=fuzzyfilter-docs",
    "deploy:react": "turbo run deploy --filter=fuzzyfilter-react",
    "deploy:vue": "turbo run deploy --filter=fuzzyfilter-vue",
    "deploy:docs": "turbo run deploy --filter=fuzzyfilter-docs",
    "docs:generate": "turbo run docs:generate",
    "docs:dev": "cd docs && mintlify dev"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "mintlify": "^4.2.257",
    "turbo": "^2.7.2"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@stoplight/spectral-core": "1.18.3",
    "@stoplight/spectral-formats": "1.6.0",
    "@stoplight/spectral-formatters": "1.3.0",
    "@stoplight/spectral-functions": "1.7.2",
    "@stoplight/spectral-parsers": "1.0.3",
    "@stoplight/spectral-rulesets": "1.18.1",
    "@stoplight/spectral-runtime": "1.1.2"
  }
}