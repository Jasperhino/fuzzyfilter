{
  "name": "fuzzyfilter-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=fuzzyfilter",
    "test:e2e": "cd packages/e2e-tests && bun x playwright test",
    "test:e2e:ui": "cd packages/e2e-tests && bun x playwright test --ui",
    "lint": "turbo run lint"
  },
  "workspaces": [
    "packages/*",
    "example/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.0.0"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=18"
  }
}