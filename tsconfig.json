{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Path mapping for monorepo
    "baseUrl": ".",
    "paths": {
      "@jasperhino/fuzzyfilter": ["./packages/fuzzyfilter/src/index.ts"],
      "fuzzyfilter-vue": ["./packages/fuzzyfilter-vue/src/index.ts"],
      "@fuzzyfilter/sample-data": ["./packages/sample-data/src/index.ts"],
      "@fuzzyfilter/axiom-exporter": ["./packages/axiom-exporter/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "playground/**/*.ts"]
}
