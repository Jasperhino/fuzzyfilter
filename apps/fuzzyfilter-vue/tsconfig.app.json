{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "fuzzyfilter": ["../../packages/fuzzyfilter/src/index.ts"],
      "fuzzyfilter/i18n/locales": ["../../packages/fuzzyfilter/src/i18n/locales/index.ts"],
      "fuzzyfilter/types/i18n": ["../../packages/fuzzyfilter/src/types/i18n.ts"],
      "vue-fuzzy-filter": ["../../packages/vue-fuzzy-filter/src/index.ts"],
      "@fuzzyfilter/sample-data": ["../../packages/sample-data/src/index.ts"],
      "@fuzzyfilter/i18n-locales": ["../../packages/i18n-locales/src/index.ts"],
      "lucide-operators": ["../../packages/lucide-operators/src/index.ts"],
      "lucide-operators-vue": ["../../packages/lucide-operators-vue/src/index.ts"],
      "lucide-operators/assets/*": ["../../packages/lucide-operators/assets/*"]
    },
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ]
}
