# Axiom Telemetry Configuration
# Copy this file to .env and fill in the values to enable telemetry

# Axiom API token with Ingest permission
VITE_AXIOM_API_KEY=your-axiom-api-token

# Axiom dataset name (use fuzzyfilter-prod for production, fuzzyfilter-benchmark for benchmarks)
VITE_AXIOM_DATASET=fuzzyfilter-prod